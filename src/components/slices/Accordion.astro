---
// Accordion — div-based (not native <details>) so open/close gets a slight
// bounce. Ported from component-style-sheet #accordion (v3's overshoot-
// easing rebuild). `items` (Repeatable Zone): one question/answer row per
// FAQ entry — add, remove, or reorder freely from the page editor.
import { asHTML, isFilled, type Slice } from "../../lib/prismicio.ts";

interface AccordionItem {
  question?: string | null;
  answer?: any;
}
interface Props {
  slice: Slice<"accordion", "default", Record<string, never>, AccordionItem>;
}
const { slice } = Astro.props;
---

<div class="accordion-section reveal">
  {slice.items.map((item, i) => {
    const html = isFilled.richText(item.answer) ? asHTML(item.answer) : null;
    return (
      <div class:list={["accordion-item", { open: i === 0 }]}>
        <button class="accordion-trigger" type="button">
          {item.question}
          <span class="accordion-icon">+</span>
        </button>
        <div class="accordion-panel">
          <div class="accordion-panel-inner">{html && <Fragment set:html={html} />}</div>
        </div>
      </div>
    );
  })}
</div>

<style>
  .accordion-section { max-width: 40rem; margin: 0 auto; padding: 3rem 1.5rem; background: var(--color-surface); }
  .accordion-item { border-bottom: 1px solid var(--color-border); }
  .accordion-trigger {
    width: 100%;
    background: none;
    border: none;
    text-align: left;
    cursor: pointer;
    padding: 1rem 0;
    font-family: var(--font-header);
    font-size: 1.05rem;
    color: var(--color-text);
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .accordion-icon {
    color: var(--color-accent-gold);
    font-size: 1.3rem;
    display: inline-block;
    transition: transform 0.45s cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  .accordion-item.open .accordion-icon { transform: rotate(45deg); }
  .accordion-panel {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.45s cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  .accordion-item.open .accordion-panel { grid-template-rows: 1fr; }
  .accordion-panel-inner { overflow: hidden; }
  .accordion-panel-inner :global(p) { margin: 0 0 1.25rem; color: var(--color-text-muted); font-size: 0.92rem; }
  @media (prefers-reduced-motion: reduce) {
    .accordion-icon, .accordion-panel { transition: none; }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>(".accordion-section:not([data-wired])").forEach((section) => {
    section.dataset.wired = "true";
    section.querySelectorAll<HTMLButtonElement>(".accordion-trigger").forEach((btn) => {
      btn.addEventListener("click", () => {
        btn.closest(".accordion-item")?.classList.toggle("open");
      });
    });
  });
</script>

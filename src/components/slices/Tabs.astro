---
// Tabs — ported from component-style-sheet #tabs. `items` (Repeatable
// Zone): one label/content row per tab — the original design's use case was
// Richmond / DC / North Carolina availability, but any label works.
import { asHTML, isFilled, type Slice } from "../../lib/prismicio.ts";

interface TabItem {
  label?: string | null;
  content?: any;
}
interface Props {
  slice: Slice<"tabs", "default", Record<string, never>, TabItem>;
}
const { slice } = Astro.props;
---

<div class="tabs-section">
  <div class="tabs-nav">
    {slice.items.map((item, i) => (
      <button type="button" class:list={{ active: i === 0 }} data-tab-btn={i}>{item.label}</button>
    ))}
  </div>
  {slice.items.map((item, i) => {
    const html = isFilled.richText(item.content) ? asHTML(item.content) : null;
    return (
      <div class:list={["tab-panel", { active: i === 0 }]} data-tab-panel={i}>
        {html && <Fragment set:html={html} />}
      </div>
    );
  })}
</div>

<style>
  .tabs-section { max-width: 40rem; margin: 0 auto; padding: 3rem 1.5rem; background: var(--color-surface-alt); }
  .tabs-nav { display: flex; gap: 1.5rem; border-bottom: 1px solid var(--color-border); margin-bottom: 1.5rem; flex-wrap: wrap; }
  .tabs-nav button {
    background: none;
    border: none;
    font-family: var(--font-menu);
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 0 0 0.75rem;
    cursor: pointer;
    color: var(--color-text-muted);
    border-bottom: 2px solid transparent;
    margin-bottom: -1px;
  }
  .tabs-nav button.active { color: var(--color-text); border-bottom-color: var(--color-accent-gold); }
  .tab-panel { display: none; font-size: 0.95rem; }
  .tab-panel.active { display: block; }
</style>

<script>
  document.querySelectorAll<HTMLElement>(".tabs-section:not([data-wired])").forEach((section) => {
    section.dataset.wired = "true";
    const buttons = Array.from(section.querySelectorAll<HTMLButtonElement>("[data-tab-btn]"));
    const panels = Array.from(section.querySelectorAll<HTMLElement>("[data-tab-panel]"));
    buttons.forEach((btn, i) => {
      btn.addEventListener("click", () => {
        buttons.forEach((b) => b.classList.remove("active"));
        panels.forEach((p) => p.classList.remove("active"));
        btn.classList.add("active");
        panels[i]?.classList.add("active");
      });
    });
  });
</script>
